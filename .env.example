# 用户与积分数据：output/users.sqlite（首次启动若存在 output/users_index.json 会自动导入并改名为 .bak）
# 英文逗号分隔；仅匹配到的手机号登录后可访问 /admin.html 与管理接口
# ADMIN_PHONES=
# 自动备份间隔（小时），默认每 6 小时备份一次
# BACKUP_INTERVAL_HOURS=6
# 最多保留备份数量，超出自动删除最旧的
# MAX_BACKUPS=30
# Database & Cache
# MONGODB_URI=
# REDIS_URL=
# CORS 允许的源（逗号分隔），不设置则允许所有来源
# CORS_ORIGIN=http://yourdomain.com,https://yourdomain.com

